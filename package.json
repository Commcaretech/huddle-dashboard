{
  "name": "community-care-management-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:setup": "node --env-file-if-exists=.env server/db/setup.js",
    "test": "vitest run && node --test server/validation.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@tanstack/react-query": "^5.0.0",
    "@vercel/functions": "3.11.4",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "better-auth": "1.7.28",
    "@better-auth/drizzle-adapter": "1.7.28",
    "zod": "$zod"
  }
}
